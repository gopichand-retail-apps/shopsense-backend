# Copy to .env.local. This file contains no credentials.
SHOPSENSE_AI_PROVIDER=gemini
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite
SHOPSENSE_AI_TIMEOUT_MS=8000
SHOPSENSE_AI_DAILY_REQUEST_LIMIT=50
SHOPSENSE_AI_MAX_CONCURRENT=2
SHOPSENSE_AI_FALLBACK_PROVIDER=none
# Optional local inference; this profile accepts loopback endpoints only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_MS=30000
# Optional hosted database. Keep sqlite until the schema/import and connection are verified.
SHOPSENSE_STORAGE=sqlite
DATABASE_URL=
SHOPSENSE_ORGANIZATION_ID=
# Public trust anchor, not a credential. Use sslmode=verify-full in DATABASE_URL.
SHOPSENSE_DATABASE_CA_FILE=certificates/supabase-prod-ca-2021.crt
# Local testing only; use a dedicated synthetic database.
SHOPSENSE_DB_PATH=data/shopsense-ai.sqlite
PORT=5802
